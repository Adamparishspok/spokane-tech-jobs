# Server-side only, for db:push and db:seed. From the Neon console.
DATABASE_URL=

# Read by the browser, and public by design: the Data API is protected by RLS
# and Neon Auth. One URL — the SDK derives the auth and REST endpoints from it.
# Shape: https://<endpoint>.<cell>.<region>.aws.neon.tech/<database>
VITE_NEON_DATABASE_URL=

# Optional. Without it the app draws its own vector basemap.
VITE_MAPBOX_TOKEN=
